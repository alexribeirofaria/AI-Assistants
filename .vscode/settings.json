{
  "files.autoSave": "afterDelay",
  "eslint.run": "onType",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "always",
    "source.organizeImports": "always"
  },
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "dbaeumer.vscode-eslint",
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "eslint.validate": ["typescript", "javascript", "html"],
  "github.copilot.enable": { "*": false },
  "codeium.enable": false,
  "editor.inlineSuggest.enabled": false,
  "editor.codeActions.triggerOnFocusChange": false,
  "editor.lightbulb.enabled": "onCode",
  "editor.quickSuggestions": {
    "other": true,
    "comments": false,
    "strings": false
  },
  "editor.experimental.useCodeActionsOnSave": false,
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[html]": {
    "editor.defaultFormatter": "HookyQR.beautify"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "prettier.requireConfig": true,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "explorer.compactFolders": false,
  "angular.enable-strict-mode-prompt": false,
  "js/ts.suggest.autoImports": true,
  "editor.codeActions": false,
  "editor.experimental.useAI": false,
  "python.analysis.extraPaths": ["./python-app"],
  "python.analysis.typeCheckingMode": "off",
  "python.analysis.autoImportCompletions": true,
  "python.analysis.useLibraryCodeForTypes": true,
  "python.analysis.diagnosticMode": "openFilesOnly",
  "[python]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  // Ruff como lint + format
  "ruff.enable": true,
  "ruff.organizeImports": true,
  // Alternativa caso use Black
  "python.formatting.provider": "none",

  // mantém autocomplete rápido
  "python.analysis.indexing": true,
  "python.analysis.inlayHints.variableTypes": true,
  "python.analysis.inlayHints.functionReturnTypes": true,
  "python.analysis.inlayHints.callArgumentNames": "all",
  "python.analysis.completeFunctionParens": true,
}

{
  "name": "ai-assistants",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "ng serve",
    "start:dev": "ng serve --configuration=development",
    "start:silent": "ng serve --open=false  --no-live-reload ",
    "prompt": "tsx --env-file=../.env src/core/app-cli-node/console.app.ts",
    "lint": "npx eslint src --ext .ts --fix",
    "lint:check": "npx eslint src --ext .ts",
    "build": "ng build",
    "build:dev": "ng build --configuration=development",
    "watch": "ng build --watch --configuration development",
    "test": "set BROWSER=ChromeHeadless && ng test --browsers=ChromeHeadless --no-watch",
    "test:prompt": "set BROWSER=ChromeHeadless && ng test --browsers=ChromeHeadless --no-watch --code-coverage --include src/core/app/**/*.spec.ts --include src/app/core/console.app.sepc.ts",
    "test:debug": "set BROWSER=Chrome && ng test --browsers=Chrome",
    "coverage": "tsx coverage_test_check.ts",
    "e2e": "npx tsx e2e/e2e-runner.ts",
    "dev:ssr": "ng run angularapp:serve-ssr",
    "serve:ssr": "node ./scripts/run-ssr-server.mjs",
    "build:ssr": "ng build && ng run angularapp:server",
    "prerender": "ng run angularapp:prerender",
    "storybook": "ng run angularapp:storybook"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "21.2.7",
    "@angular/cdk": "21.2.7",
    "@angular/common": "21.2.7",
    "@angular/compiler": "21.2.7",
    "@angular/core": "21.2.7",
    "@angular/forms": "21.2.7",
    "@angular/material": "21.2.7",
    "@angular/platform-browser": "21.2.7",
    "@angular/platform-browser-dynamic": "21.2.7",
    "@angular/platform-server": "21.2.7",
    "@angular/router": "21.2.7",
    "@angular/ssr": "21.2.7",
    "@anthropic-ai/sdk": "0.62.0",
    "@google/genai": "1.30.0",
    "@ng-bootstrap/ng-bootstrap": "20.0.0",
    "bootstrap": "5.3.8",
    "bootstrap-icons": "1.13.1",
    "express": "5.1.0",
    "openai": "6.5.0",
    "rxjs": "~7.8.2",
    "tslib": "2.8.1",
    "zone.js": "^0.16.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.7",
    "@angular-eslint/builder": "21.3.1",
    "@angular-eslint/eslint-plugin": "21.3.1",
    "@angular-eslint/eslint-plugin-template": "21.3.1",
    "@angular-eslint/schematics": "21.3.1",
    "@angular-eslint/template-parser": "21.3.1",
    "@angular/cli": "21.2.7",
    "@angular/compiler-cli": "21.2.7",
    "@angular/localize": "21.2.7",
    "@eslint/js": "9.17.0",
    "@playwright/test": "1.59.1",
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-onboarding": "^10.3.6",
    "@storybook/angular": "10.3.6",
    "@types/bootstrap": "5.2.10",
    "@types/express": "5.0.1",
    "@types/jasmine": "~6.0.0",
    "@types/jquery": "3.5.32",
    "@types/node": "24.0.0",
    "@typescript-eslint/eslint-plugin": "8.58.2",
    "@typescript-eslint/parser": "8.58.2",
    "@vitest/coverage-v8": "^4.1.5",
    "browser-sync": "3.0.4",
    "eslint": "9.39.4",
    "jasmine": "^6.2.0",
    "jasmine-core": "~6.2.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "playwright-ng-schematics": "21.0.9",
    "ts-evaluator": "2.0.0",
    "ts-node": "10.9.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "autoprefixer": "^10.4.5",
    "uuid": "^11.0.0",
    "@eslint/eslintrc": {
      "ajv": "^6.12.6",
      "ajv-keywords": "^3.5.2"
    }
  },
  "optionalDependencies": {
    "bufferutil": "4.1.0",
    "utf-8-validate": "6.0.6"
  }
}

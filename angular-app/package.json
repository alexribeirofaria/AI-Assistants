{
  "name": "ai-assistants",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "ng serve ",
    "start:dev": "ng serve --configuration=development",
    "start:silent": "ng serve --open=false  --no-live-reload ",
    "lint": "npx eslint src/**/*.ts --fix",
    "lint:check": "npx eslint src/**/*.ts",
    "build": "ng build",
    "build:dev": "ng build --configuration=development",
    "watch": "ng build --watch --configuration development",
    "test": "set BROWSER=ChromeHeadless && ng test --browsers=ChromeHeadless --no-watch",
    "test:debug": "set BROWSER=Chrome && ng test --browsers=Chrome",
    "coverage": "node coverage_test_check.ts",
    "e2e": "node .\\e2e\\e2e-runner.ts"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "21.2.7",
    "@angular/cdk": "^21.1.0",
    "@angular/common": "21.2.7",
    "@angular/compiler": "21.2.7",
    "@angular/core": "21.2.7",
    "@angular/forms": "21.2.7",
    "@angular/material": "^21.2.6",
    "@angular/platform-browser": "21.2.7",
    "@angular/platform-browser-dynamic": "21.2.7",
    "@angular/router": "21.2.7",
    "@ng-bootstrap/ng-bootstrap": "^20.0.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.7",
    "@angular-eslint/builder": "^21.3.1",
    "@angular-eslint/eslint-plugin": "^21.3.1",
    "@angular-eslint/eslint-plugin-template": "^21.3.1",
    "@angular-eslint/schematics": "^21.3.1",
    "@angular-eslint/template-parser": "^21.3.1",
    "@angular/cli": "21.2.7",
    "@angular/compiler-cli": "21.2.7",
    "@angular/localize": "21.2.7",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.59.1",
    "@types/bootstrap": "^5.2.10",
    "@types/jasmine": "~6.0.0",
    "@types/jquery": "^3.5.32",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "eslint": "^9.39.4",
    "jasmine": "^6.2.0",
    "jasmine-core": "~6.2.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "playwright-ng-schematics": "^21.0.9",
    "ts-evaluator": "^2.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "autoprefixer": "10.4.5",
    "@eslint/eslintrc": {
      "ajv": "^6.12.6",
      "ajv-keywords": "^3.5.2"
    }
  }
}
